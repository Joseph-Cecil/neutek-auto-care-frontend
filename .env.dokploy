# Paste into Dokploy → Frontend Application → Build Args / Environment (build-time).
# NEXT_PUBLIC_* are baked into the Next.js bundle — rebuild after any change.

NEXT_PUBLIC_API_URL=https://auto-care-backend.skulcore.com/api/v1
NEXT_PUBLIC_WS_URL=https://auto-care-backend.skulcore.com
NEXT_PUBLIC_APP_URL=https://autocare.skulcore.com
NEXT_PUBLIC_APP_NAME=Neutek Auto Care
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=
